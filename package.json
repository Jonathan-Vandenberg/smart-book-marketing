    "jsonwebtoken": "^9.0.3",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.25",
    "node-cron": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
