{
  "name": "smart-book-marketing",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic marketing, analytics, and dashboard for Smart Book Planner",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
