# Server
PORT=3001
NODE_ENV=development
DASHBOARD_SECRET=change-me-long-random-string

# Auth — only these Google accounts may sign in
ALLOWED_ADMIN_EMAILS=urbangentryjon@gmail.com
AUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3001
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Smart Book Planner product
PRODUCT_URL=https://smartbookplanner.com
PRODUCT_NAME=Smart Book Planner
# Product admin API (user credits + feature credit config)
PRODUCT_API_URL=http://localhost:3000
PRODUCT_ADMIN_SECRET=change-me-same-as-rogan-writer-ADMIN_API_SECRET

# Agent scheduling (SAST = UTC+2; cron uses server timezone)
AGENTS_ENABLED=true
SIGNAL_CRON=0 6 * * 1
CONTENT_CRON=0 7 * * 1
ANALYTICS_CRON=0 6 * * 5
DAILY_TIP_CRON=0 12 * * *
PUBLISH_CRON=0 8 * * *

# OpenRouter (content + analytics agents)
OPENROUTER_API_KEY=

# Publishing — social (Buffer GraphQL API) + blog (Ghost)
BUFFER_ACCESS_TOKEN=
# Optional: skip auto-discovery
# BUFFER_ORGANIZATION_ID=
# BUFFER_CHANNEL_IDS=channel_id_1,channel_id_2

# Ghost blog (blog.smartbookplanner.com)
# Create custom integration in Ghost Admin → Settings → Integrations
GHOST_URL=https://blog.smartbookplanner.com
GHOST_ADMIN_API_KEY=
# Secret query param for post.published webhook → /api/webhooks/ghost?secret=...
GHOST_WEBHOOK_SECRET=

# Google Analytics 4 (analytics agent)
# App reads GA4_PROPERTY_ID + GOOGLE_SERVICE_ACCOUNT_KEY_PATH (path to JSON key file).
# GitHub Actions secrets (production only):
#   MARKETING_GA4_PROPERTY_ID → GA4_PROPERTY_ID
#   MARKETING_GA_SERVICE_ACCOUNT_JSON → written to service-account-key.json on deploy
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Google Search Console (signal agent — same service account if granted access)
GSC_SITE_URL=https://www.smartbookplanner.com

# Optional legacy integrations
TYPEFULLY_API_KEY=

# DigitalOcean deploy (primary — same server as rogan-writer)
DO_HOST=209.97.163.64
DO_USER=root
